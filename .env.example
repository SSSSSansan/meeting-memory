# Скопируйте в .env (он в .gitignore, ключи в git не попадут): cp .env.example .env

# stub = без модели, для разработки каркаса | openai | local (vLLM/Ollama)
LLM_BACKEND=stub
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# openai
OPENAI_API_KEY=

# local (OpenAI-совместимый сервер, например vLLM)
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=not-needed

# Цены в USD за 1M токенов — возьмите АКТУАЛЬНЫЕ со страницы провайдера.
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# Жёсткий лимит расходов на человека, USD
BUDGET_USD=3.0
